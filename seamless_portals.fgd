@PointClass base(Targetname, Parentname, Angles) studio("models/editor/cone_helper.mdl") line(100 100 255, targetname, link) = seamless_portal : "Create a seamless portal"
[
	size(vector)				: "Portal Size" : "100 100 8" : "Portal size in hammer units."
	sides(integer)				: "Portal Sides" : 4 : "Portal number of sides."
	link(target_destination)	: "Linked Portal" : "" : "Another seamless portal entity to link to."
	backface(choices) 			: "Backface" : 0 : "Toggle the portal's backface." =
	[
		0: "On"
		1: "Off"
	]
	gmod_allowphysgun(choices)	: "Allow Physics Gun" : 1 : "If set, players cannot use Physics Gun on this entity." =
	[
		0: "No"
		1: "Yes"
	]
	gmod_allowtools(string)		: "Sandbox Tool Whitelist" : "" : "If set, only given tools can be used on this entity.\nYou need to supply the tool class names, the names of the .lua files of those tools.\nThis also includes the context menu properties!"
	version(integer)			: "Version" : 2 : "For forwards compatability. Don't change this"

	disablePropTeleport(choices) : "Disable prop passage" : 0 = [ 0 : "No" 1 : "Yes" ]
	disablePlayerTeleport(choices) : "Disable player passage" : 0 = [ 0 : "No" 1 : "Yes" ]
	disableDamageTransfer(choices) : "Disable hitscan damage transfer" : 0 = [ 0 : "No" 1 : "Yes" ]
	disableSoundTransfer(choices) : "Disable spatial sound transfer" : 0 = [ 0 : "No" 1 : "Yes" ]
	enableFunneling(choices) : "Enable funneling assistance" : 0 = [ 0 : "No" 1 : "Yes" ]

	// Inputs
	input Link(target_destination) : "Links a new portal. (Empty parameter will unlink the portal)"

	input EnablePropTeleport(void) : "Enable PropTeleport"
	input DisablePropTeleport(void) : "Disable PropTeleport"

	input EnablePlayerTeleport(void) : "Enable PlayerTeleport"
	input DisablePlayerTeleport(void) : "Disable PlayerTeleport"

	input EnableDamageTransfer(void) : "Enable DamageTransfer"
	input DisableDamageTransfer(void) : "Disable DamageTransfer"

	input EnableSoundTransfer(void) : "Enable SoundTransfer"
	input DisableSoundTransfer(void) : "Disable SoundTransfer"

	input EnableFunneling(void) : "Enable Funneling"
	input DisableFunneling(void) : "Disable Funneling"

	// Outputs
	output OnTeleportFrom(target_destination)	: "When any entity is teleported from a portal to the linked partner."
	output OnTeleportTo(target_destination)		: "When any entity is teleported from a linked partner to the portal."
]
